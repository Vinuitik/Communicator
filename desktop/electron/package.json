{
  "name": "communicator-desktop",
  "version": "1.0.0",
  "description": "Thin Electron shell that loads the live Communicator web app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.communicator.desktop",
    "productName": "Communicator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "communicator-desktop-setup.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "artifactName": "communicator-desktop.AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
