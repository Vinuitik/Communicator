<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.communicator</groupId>
        <artifactId>communicator-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Friend domain module (library). Base package: communicate.Friend.* -->
    <artifactId>friend</artifactId>
    <name>friend</name>

    <dependencies>
        <dependency>
            <groupId>com.communicator</groupId>
            <artifactId>knowledge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.communicator</groupId>
            <artifactId>outbox-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Flashcard-review enrollment (FlashcardEnrollmentService) reads
             GroupKnowledge/SocialGroup to inherit group facts into a starred
             friend's folder. group does not depend on friend (checked — no
             cross-refs either direction previously), so this stays a clean,
             acyclic addition; it mirrors chrono's own friend-module
             dependency for cross-module JPA reads within the merged
             monolith's single datasource (see PathPrefixConfig). -->
        <dependency>
            <groupId>com.communicator</groupId>
            <artifactId>group</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- WebClient for calling other internal services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- FlatLaf (not Spring-managed; keep explicit version) -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
