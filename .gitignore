# Global ignore patterns for the entire Communicator project

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS generated files
*.log
*.tmp
*.temp

# Backup files
*.bak
*.backup
*~

# Environment files (global)
.env
.env.local
.env.*.local

# Service account keys and secrets
backup/service-account-key.json
ai_agent/.env
ai_agent/service-account-key.json
**/service-account-key.json
**/*.key
**/*.pem
**/secrets.json

# Cache directories
.cache/
**/__pycache__/
**/.venv/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
.claude/

# Build directories
**/build/
**/dist/
**/*.egg-info/

# Node modules (if any JavaScript projects)
**/node_modules/

# Node/TS generated files (lockfiles regenerate from package.json; tsbuildinfo
# is tsc's incremental-build cache)
**/package-lock.json
**/yarn.lock
**/*.tsbuildinfo
**/npm-debug.log*

# Playwright's own generated artifact dir (e2e/)
**/test-results/
**/yarn-debug.log*
**/yarn-error.log*

# Resource files (as you already have)
resourceRepository/photos/**
resourceRepository/videos/**
resourceRepository/voice/**
resourceRepository/personalResources/**

# Log files
**/*.log
**/logs/
# Maven build output
target/

# Generated Firefox build of extension/ (extension/build-firefox-extension.sh) —
# not checked in, regenerate locally from extension/manifest.json + the overlay
extension-firefox/
# Signed .xpi + updates.json published by extension/deploy-extension.sh (nginx
# serves these live via a bind mount — see docker-compose.yml's nginx volumes)
ext-dist/
# npx/web-ext download cache reused across signings (keeps re-signs fast)
.web-ext-cache/
